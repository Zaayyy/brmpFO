# Konfigurasi Akun FTP Rumahweb untuk Deploy Otomatis
# Salin nilai ini ke file .env dan isi dengan kredensial dari cPanel Rumahweb

FTP_HOST=ftp.namadomainanda.com
FTP_USER=username_ftp@namadomainanda.com
FTP_PASSWORD=password_ftp_anda
FTP_PORT=21
FTP_REMOTE_DIR=/public_html
FTP_SECURE=false

# Konfigurasi Integrasi Cloud Google Spreadsheet
VITE_GOOGLE_SHEET_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxwyQ6FsIMB_bGLjJ5JuxtQhG89whys7uxYOSQnlw8v0CSWYWg2kfixglZDQjm7aTY8/exec
